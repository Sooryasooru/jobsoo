# jobsoo — environment configuration (copy to .env and fill in)
# NEVER commit the real .env or any API keys.

# PostgreSQL connection string (SQLAlchemy psycopg3 driver).
# Example for a Unix-socket Postgres (peer auth, Linux dev):
DATABASE_URL=postgresql+psycopg://soorya@/jobsoo_dev?host=/var/run/postgresql
# Example for Docker Compose Postgres:
# DATABASE_URL=postgresql+psycopg://jobsoo:jobsoo@localhost:5433/jobsoo_dev

# --- Adzuna job source (https://developer.adzuna.com/) ---
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Which country index to search, e.g. "ae" (UAE), "gb", "us"
ADZUNA_COUNTRY=ae

# --- Anthropic Claude API (https://console.anthropic.com/) ---
ANTHROPIC_API_KEY=
# Model identifier used for extraction/tailoring
CLAUDE_MODEL=claude-sonnet-4-5

# --- Application settings ---
LOG_LEVEL=INFO
CV_UPLOAD_DIR=./data/uploads
MAX_CV_UPLOAD_MB=10
STORAGE_DIR=./data/storage

# Single-user prototype (auth is deferred; see docs/security.md)
JOBSOO_USER_EMAIL=dev@example.com
